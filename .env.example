# ── Base de dades MySQL al núvol (TiDB Cloud, Aiven, Railway, etc.) ──
# Format: mysql://USUARI:CONTRASENYA@HOST:PORT/NOM_BD
DATABASE_URL=mysql://usuari:contrasenya@host:4000/carretons
# Posa-ho a "false" només si el teu proveïdor NO fa servir TLS
# DB_SSL=false
# Posa-ho a "true" si el proveïdor usa un certificat propi (p.ex. Aiven) i falla la verificació
# DB_SSL_INSECURE=true

# ── Sessió i codis d'accés ──
# Cadena llarga i aleatòria (mínim 16 caràcters). Genera-la amb: openssl rand -hex 32
SESSION_SECRET=canvia-aixo-per-una-cadena-llarga-i-aleatoria
CODE_STANDARD=
CODE_ADMIN=
CODE_SPEAKER=

# ── Notificacions push (opcional) ──
# JSON complet del "service account" de Firebase (FCM HTTP v1), en una sola línia
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
